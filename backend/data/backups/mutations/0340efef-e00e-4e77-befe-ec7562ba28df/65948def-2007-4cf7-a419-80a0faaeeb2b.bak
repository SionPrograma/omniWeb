<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>OmniWeb | AI Host Shell</title>
    <!-- Google Fonts: Inter & Outfit -->
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Outfit:wght@200;400;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/shell/style.css">
    <link rel="stylesheet" href="/shell/logbook.css">
    <link rel="stylesheet" href="/shell/editor.css">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/shell/creator.css">
    <link rel="stylesheet" href="/shell/cluster.css">
    <link rel="stylesheet" href="/shell/workload.css">
    <link rel="stylesheet" href="/shell/mesh.css">
    <link rel="stylesheet" href="/shell/offline.css">
    <link rel="stylesheet" href="/shell/runtime.css">
    <link rel="stylesheet" href="/shell/storage.css">
    <link rel="stylesheet" href="/shell/human_dev.css">
    <link rel="stylesheet" href="/shell/ecosystem_collab.css">
    <link rel="stylesheet" href="/shell/scaling_beta.css">
    <link rel="stylesheet" href="/shell/creator_theme.css">
    <link rel="stylesheet" href="/shell/builder.css">
    <link rel="manifest" href="/shell/manifest.json">
    <meta name="theme-color" content="#050508">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="OmniWeb">
    <link rel="apple-touch-icon" href="/shell/assets/logo.png">
</head>

<body>
    <!-- Background Nebula/Particles -->
    <div class="nebula-bg"></div>
    <div class="particles" id="particles"></div>

    <div id="shell-container">
        <!-- GLOBAL ANNOUNCEMENT BAR -->
        <div class="global-announcement-bar" id="global-announcement" style="display: none;">
            <div class="announcement-content">
                <span class="announcement-icon">!</span>
                <span id="announcement-text">System maintenance scheduled.</span>
            </div>
        </div>

        <!-- SYSTEM STATUS BAR -->
        <div class="system-status-bar" id="system-status">
            <div class="status-group">
                <div class="status-pill">
                    <span class="status-dot online"></span>
                    <span>OmniWeb</span>
                    <span class="version-tag" id="sys-status-version">v0.0.0</span>
                    <span id="creator-badge"
                        style="display: none; margin-left: 6px; background: #32ff96; color: #000; padding: 0 5px; border-radius: 4px; font-size: 0.6rem; font-weight: bold;">CREATOR</span>
                </div>
                <!-- Phase 31: Creator QR Scan Shortcut -->
                <button class="qr-scan-btn" id="global-qr-scan" style="display:none; margin-left: 10px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path
                            d="M3 7V5a2 2 0 0 1 2-2h2m10 0h2a2 2 0 0 1 2 2v2m0 10v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2" />
                        <rect x="7" y="7" width="3" height="3" />
                        <rect x="14" y="7" width="3" height="3" />
                        <rect x="7" y="14" width="3" height="1" />
                    </svg>
                    <span>SCAN ACCESS</span>
                </button>
                <div class="status-pill">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 3h12l4 6-10 13L2 9z" />
                    </svg>
                    <span id="sys-status-branch">master</span>
                </div>
            </div>
            <div class="status-group">
                <div class="status-pill">
                    <span id="sys-chips-count">0</span> Chips
                </div>
                <div class="status-pill">
                    <span class="status-dot online" id="ai-indicator"></span>
                    <span>AI: Active</span>
                </div>
                <div class="status-pill">
                    <span class="status-dot online" id="db-indicator"></span>
                    <span>DB: OK</span>
                </div>
            </div>
        </div>
        <!-- AI HOST VIEW (LANDING) -->
        <main id="ai-host-view" class="active">
            <div class="ai-core-container">
                <div class="ai-orb" id="main-ai-orb">
                    <div class="ai-orb-inner"></div>
                    <div class="ai-orb-glow"></div>
                    <div class="orb-status-ring"></div>
                </div>
                <h1 class="greeting-text" id="greeting">Omni Shell</h1>
                <p class="status-subtitle">System: Online | Context: Global</p>
            </div>

            <div class="chat-interaction-area">
                <div class="conversation-log" id="chat-log">
                    <!-- Dynamic messages -->
                    <div class="message ai">
                        <div class="msg-bubble">How can I assist you today? I'm observing your active chips and
                            long-term memory.</div>
                    </div>
                </div>
            </div>
        </main>

        <!-- CHIP VIEW (IFRAME CONTAINER) -->
        <section id="active-chip-view">
            <div class="chip-header">
                <button class="exit-chip-btn" id="close-chip">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 12H5M12 19l-7-7 7-7" />
                    </svg>
                    <span style="margin-left: 8px; font-size: 0.8rem; font-weight: 600;">BACK</span>
                </button>
                <span id="active-chip-title">Chip: Lingua</span>
                <div class="chip-options">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="1" />
                        <circle cx="12" cy="5" r="1" />
                        <circle cx="12" cy="19" r="1" />
                    </svg>
                </div>
            </div>
            <iframe id="chip-frame" src="" frameborder="0"></iframe>
        </section>

        <!-- MISSION CONTROL (COCKPIT) -->
        <main id="mission-control-view">
            <header class="cockpit-header">
                <h1>Mission Control</h1>
                <div class="cockpit-tabs">
                    <button class="cockpit-tab active" data-tab="health">General Health</button>
                    <button class="cockpit-tab" data-tab="map">Galaxy Map</button>
                    <button class="cockpit-tab" data-tab="fixes">Auto-Healing</button>
                    <button class="cockpit-tab" data-tab="insights">Insights</button>
                    <button class="cockpit-tab" data-tab="security">Security</button>
                    <button class="cockpit-tab" data-tab="admin">Admin Ops</button>
                    <button class="cockpit-tab" data-tab="creator">Creator Plane</button>
                    <button class="cockpit-tab" data-tab="cluster">Cluster</button>
                    <button class="cockpit-tab" data-tab="mesh">Mesh</button>
                    <button class="cockpit-tab" data-tab="autonomous">Autonomous</button>
                    <button class="cockpit-tab" data-tab="runtime">Boot Runtime</button>
                    <button class="cockpit-tab" data-tab="storage">Storage Grid</button>
                    <button class="cockpit-tab" data-tab="knowledge">Knowledge Explorer</button>
                    <button class="cockpit-tab" data-tab="learning">Learning Paths</button>
                    <button class="cockpit-tab" data-tab="certs">Certifications</button>
                    <button class="cockpit-tab" data-tab="opportunities">Opportunities</button>
                    <button class="cockpit-tab" data-tab="collab">Collaborative Projects</button>
                    <button class="cockpit-tab" data-tab="labs">Creator Labs</button>
                    <button class="cockpit-tab" data-tab="market">Knowledge Market</button>
                    <button class="cockpit-tab" data-tab="mentor">AI Mentor</button>
                    <button class="cockpit-tab" data-tab="omniverse">Omniverse Gate</button>
                    <button class="cockpit-tab" data-tab="observability">Global Telemetry</button>
                    <button class="cockpit-tab" data-tab="beta">Beta Testing</button>
                    <button class="cockpit-tab" data-tab="archival">Data Archive</button>
                    <button class="cockpit-tab" data-tab="communication">Communication</button>
                    <button class="cockpit-tab" data-tab="accessibility">Accessibility</button>
                    <button class="cockpit-tab" data-tab="workload">Workload</button>
                    <button class="cockpit-tab" data-tab="music">Music Lab</button>
                    <button class="cockpit-tab" data-tab="integration">Integration</button>
                    <button class="cockpit-tab" data-tab="copilot">AI Copilot</button>
                    <button class="cockpit-tab" data-tab="qr_gateway">QR Gateway</button>
                    <button class="cockpit-tab" data-tab="governance">Governance</button>
                    <button class="cockpit-tab" data-tab="sync">Device Sync</button>
                    <button class="cockpit-tab" data-tab="editor">Code Editor</button>
                    <button class="cockpit-tab" data-tab="code">System Modules</button>
                </div>
            </header>

            <div class="cockpit-content">
                <div id="cockpit-main-panel">
                    <div class="loading-indicator">Synchronizing with system core...</div>
                </div>
            </div>
        </main>

        <!-- CONTEXT PANEL (OVERLAY) -->
        <aside id="context-panel">
            <div class="panel-handle"></div>
            <header class="panel-header">
                <button class="close-panel" id="close-context">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                </button>
                <h2>System Inspection</h2>
            </header>
            <div class="panel-content">
                <div class="context-section">
                    <h3>Loaded Chips</h3>
                    <div class="chip-status-list" id="chip-status-container">
                        <!-- Dynamic chip status cards -->
                        <div class="loading-indicator">Scanning modules...</div>
                    </div>
                </div>
                <div class="context-section">
                    <h3>Host Metrics</h3>
                    <div class="context-item">
                        <span class="label">AI Logic</span>
                        <span class="value">Hybrid / Neural</span>
                    </div>
                    <div class="context-item">
                        <span class="label">Context Loop</span>
                        <span class="value">Active</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- SHELL NAVIGATION (BOTTOM NAV) -->
        <nav id="bottom-nav">
            <button class="nav-item active" data-view="chat">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                <span>Chat</span>
            </button>

            <button class="nav-item" onclick="window.location.href='/dashboard'">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                </svg>
                <span>Dashboard</span>
            </button>

            <button class="nav-item shell-launcher" id="open-launcher">
                <div class="launcher-icon">
                    <span></span><span></span><span></span><span></span>
                </div>
            </button>

            <button class="nav-item" data-view="context">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2a10 10 0 1 0 10 10H12V2z" />
                    <path d="M12 12L2.7 16.5" />
                    <path d="M12 12l7.5 7.5" />
                </svg>
                <span>Chips</span>
            </button>

            <button class="nav-item" data-view="mission">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="8" rx="2" />
                    <rect x="2" y="14" width="20" height="8" rx="2" />
                    <line x1="6" y1="6" x2="6" y2="6" />
                    <line x1="6" y1="18" x2="6" y2="18" />
                </svg>
                <span>Mission</span>
            </button>

            <button class="nav-item" onclick="masterLogbook.toggle()">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </svg>
                <span>Logbook</span>
            </button>
        </nav>

        <!-- LAUNCHER OVERLAY -->
        <div id="launcher-overlay">
            <div class="launcher-header">
                <h2>Galactic Launcher</h2>
                <button id="close-launcher" class="close-overlay-btn">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 6L6 18M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="launcher-grid">
                <div class="chip-launcher-item" data-chip="copilot"
                    onclick="creatorEnv.switchView('mission'); creatorEnv.currentTab = 'copilot'; creatorEnv.renderCockpit(); omniShell.closeLauncher();">
                    <div class="chip-icon" style="background: rgba(0, 212, 255, 0.2); border-color: var(--accent);">
                        🤖
                    </div>
                    <span class="chip-label">AI Copilot</span>
                </div>
                <div class="chip-launcher-item active" data-chip="lingua" data-url="/lingua/">
                    <div class="chip-icon lingua">L</div>
                    <span class="chip-label">Lingua</span>
                </div>
                <div class="chip-launcher-item" data-chip="finanzas" data-url="/finanzas/">
                    <div class="chip-icon finanzas">F</div>
                    <span class="chip-label">Finanzas</span>
                </div>
                <div class="chip-launcher-item disabled">
                    <div class="chip-icon empty">+</div>
                    <span class="chip-label">More</span>
                </div>
            </div>
        </div>

        <!-- Phase 32: Multimodal Evidence Panel -->
        <div id="shell-media-evidence" class="media-evidence-panel">
            <div class="evidence-header">
                <h4><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        style="margin-right:5px;">
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <path d="M21 15l-5-5L5 21" />
                    </svg> EVIDENCE BATCH</h4>
                <div style="display:flex; gap: 8px;">
                    <span class="evidence-count" id="shell-media-count">0</span>
                    <button class="upload-trigger-btn" onclick="creatorEnv.clearMedia()">CLEAR</button>
                </div>
            </div>
            <div class="evidence-grid" id="shell-media-grid"></div>
        </div>

        <div class="input-bar">
            <input type="file" id="global-media-upload" multiple accept="image/*,video/*" style="display:none;"
                onchange="creatorEnv.handleMediaUpload(this)">
            <button id="media-upload-trigger" onclick="document.getElementById('global-media-upload').click()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4m4-5l5-5 5 5m-5-5v12" />
                </svg>
            </button>
            <input type="text" placeholder="Command Omni..." id="shell-input">
            <button id="voice-command">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" />
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                    <line x1="12" y1="19" x2="12" y2="23" />
                    <line x1="8" y1="23" x2="16" y2="23" />
                </svg>
            </button>
            <button id="send-command">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
                </svg>
            </button>
        </div>
    </div>

    <!-- PERMISSION MODAL -->
    <div id="permission-modal">
        <div class="modal-content">
            <h3 id="perm-title">Permission Required</h3>
            <p id="perm-message">Execute development prompt?</p>
            <div class="modal-actions">
                <button class="modal-btn btn-cancel" id="perm-cancel">Cancel</button>
                <button class="modal-btn btn-confirm" id="perm-confirm">Confirm</button>
            </div>
        </div>
    </div>

    <!-- QR SCANNER OVERLAY (Phase 31) -->
    <div id="qr-scanner-overlay">
        <h3 style="color: var(--creator-gold); margin-bottom: 15px; font-family: 'Outfit';">Creator Access Scan</h3>
        <p style="font-size: 0.75rem; opacity: 0.7; margin-bottom: 15px;">Alinea el código QR del creador dentro del
            marco dorado.</p>
        <div class="scanner-video-wrap">
            <video id="scanner-video" autoplay playsinline></video>
            <div class="scanner-frame"></div>
        </div>
        <div class="scanner-controls">
            <button class="cockpit-btn" onclick="creatorEnv.closeScanner()">CANCEL</button>
            <button class="btn-apply" id="sim-scan-btn">SIMULATE SCAN</button>
        </div>
    </div>

    <script src="/shell/voice.js"></script>
    <script src="/shell/builder.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/shell/sw.js').then(reg => {
                    console.log('OmniWeb Service Worker Registered.');
                }).catch(err => {
                    console.error('Service Worker Registration Failed:', err);
                });
            });
        }
    </script>
    <script src="/shell/galaxy.js"></script>
    <script src="/shell/creator.js"></script>
    <script src="/shell/editor.js"></script>
    <script src="/shell/logbook.js"></script>
    <script src="/shell/main.js"></script>

</body>

</html>